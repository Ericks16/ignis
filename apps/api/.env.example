# Copiar a .env (nunca subir .env al repositorio)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ignis:ignis@localhost:5433/ignis
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
# Zona horaria de negocio
APP_TIMEZONE=America/Guayaquil
# Duración de la sesión en horas
SESSION_TTL_HOURS=12
# Solo para el seed inicial (cambiar y NO commitear valores reales)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Correo y recordatorios (Fase 6) ---
# URL pública del frontend (enlaces de los correos)
APP_URL=http://localhost:5173
# test = NUNCA envía correos reales (solo los registra). live = envía de verdad.
EMAIL_MODE=test
# console | resend | brevo (con EMAIL_MODE=live debe ser resend o brevo)
EMAIL_PROVIDER=console
EMAIL_FROM=IGNIS <no-reply@tudominio.com>
RESEND_API_KEY=
BREVO_API_KEY=
# Durante el piloto: solo estos destinatarios recibirán correos reales (separados por coma). Vacío = sin restricción.
EMAIL_ALLOWED_RECIPIENTS=
# Secreto (mín. 24 caracteres) del endpoint del cron externo: POST /api/internal/cron/reminders con la cabecera x-cron-secret
CRON_SECRET=
